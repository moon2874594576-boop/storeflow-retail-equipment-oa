# Docker Compose reads this file after copying it to .env.
# This database password is an example: choose your own local value before starting.
POSTGRES_DB=storeflow
POSTGRES_USER=storeflow
POSTGRES_PASSWORD=change-this-local-database-password
STOREFLOW_DEMO_PASSWORD=Demo2026!
# Demo mode is for fictional local interview data. Disable for your own non-demo use.
STOREFLOW_DEMO=1
